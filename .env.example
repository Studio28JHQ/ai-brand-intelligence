# Backend
NODE_ENV=development
PORT=3001

# Web frontend -> Backend
API_URL=http://localhost:3001
# Backend -> Web frontend (used to build links in transactional emails, e.g. the "Verify Email" button)
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_HOST=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Operational settings (all optional locally — see docs/04_PROJECT/PRODUCTION_READINESS.md)
# Comma-separated list of origins allowed to call the API directly from a browser.
CORS_ORIGIN=http://localhost:3000
# Sliding window used by the global rate limiter.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
# Maximum time a single request may take before the API returns 408.
REQUEST_TIMEOUT_MS=30000
# debug | info | warn | error — defaults to 'debug' outside production, 'info' in production.
LOG_LEVEL=debug

# NODE_ENV=production additionally REQUIRES DATABASE_URL, POSTGRES_PASSWORD, MINIO_ROOT_USER,
# MINIO_ROOT_PASSWORD, and JWT_SECRET to be set explicitly — the platform refuses to start
# otherwise rather than silently running against the development defaults above.

# Authentication (see docs/04_PROJECT/AUTHENTICATION.md)
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
JWT_SESSION_EXPIRATION_MINUTES=60
JWT_REMEMBER_ME_EXPIRATION_DAYS=30
OTP_EXPIRATION_MINUTES=10
EMAIL_FROM=no-reply@ai-visibility-auditor.local
# Optional. If set, replies to a delivered email go here instead of EMAIL_FROM.
# EMAIL_REPLY_TO=
# The platform's real default is "resend" — real delivery is expected, not opt-in — so an
# environment with NO .env file at all (EMAIL_PROVIDER unset) will refuse to start without a real
# RESEND_API_KEY (F9-S02-HF03). This template pins EMAIL_PROVIDER=console explicitly instead, as a
# documented, zero-cost opt-out for local development: copy this file to .env and email is logged,
# not delivered, with no provider account required. Delete this line (or set it to "resend") once
# RESEND_API_KEY below is a real key, to send real email.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend (or when EMAIL_PROVIDER is omitted, since "resend" is the
# platform default). Sign up at https://resend.com, verify a sending domain matching EMAIL_FROM,
# then create a key at https://resend.com/api-keys. The API refuses to start if a real provider is
# active and this is missing.
# RESEND_API_KEY=

# AI Provider configuration (see docs/04_PROJECT/AI_ARCHITECTURE.md). All optional — startup never
# fails because a provider is unconfigured; each shows as "missing API key" in the startup log and
# "Not Configured" from Test Connection (GET/POST /platform/ai-providers) until a key is set. None
# of these are used by any product feature today (the AI Consultant/Daily Briefing are deterministic,
# see docs/04_PROJECT/AI_ARCHITECTURE.md) — this is connectivity/configuration infrastructure only.
# OPENAI_API_KEY=
OPENAI_ENABLED=true
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_TOKENS=4096

# ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=true
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_MAX_TOKENS=4096

# GOOGLE_API_KEY=
GOOGLE_ENABLED=true
GOOGLE_DEFAULT_MODEL=gemini-1.5-flash
GOOGLE_TIMEOUT_MS=30000
GOOGLE_MAX_TOKENS=4096

# XAI_API_KEY=
XAI_ENABLED=true
XAI_DEFAULT_MODEL=grok-2-latest
XAI_TIMEOUT_MS=30000
XAI_MAX_TOKENS=4096

# OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_TOKENS=4096

# PERPLEXITY_API_KEY=
PERPLEXITY_ENABLED=true
PERPLEXITY_DEFAULT_MODEL=sonar
PERPLEXITY_TIMEOUT_MS=30000
PERPLEXITY_MAX_TOKENS=4096
