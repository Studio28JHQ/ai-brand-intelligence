generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model PlatformMeta {
  id             Int      @id @default(autoincrement())
  bootstrappedAt DateTime @default(now()) @map("bootstrapped_at")

  @@map("platform_meta")
}

model AuditRequest {
  id          String    @id @default(uuid())
  url         String
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  discoveryResult DiscoveryResult?
  crawlResult     CrawlResult?
  inventoryResult InventoryResult?
  findings        Finding[]
  entities        Entity[]
  graphNodes      GraphNode[]
  graphRelationships GraphRelationship[]

  @@map("audit_requests")
}

model DiscoveryResult {
  id                String   @id @default(uuid())
  auditId           String   @unique @map("audit_id")
  normalizedUrl     String   @map("normalized_url")
  robotsTxtUrl      String   @map("robots_txt_url")
  robotsTxtDetected Boolean  @map("robots_txt_detected")
  sitemapUrl        String   @map("sitemap_url")
  sitemapDetected   Boolean  @map("sitemap_detected")
  createdAt         DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("discovery_results")
}

model CrawlResult {
  id         String   @id @default(uuid())
  auditId    String   @unique @map("audit_id")
  finalUrl   String   @map("final_url")
  httpStatus Int      @map("http_status")
  headers    Json
  html       String
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("crawl_results")
}

model InventoryResult {
  id                 String   @id @default(uuid())
  auditId            String   @unique @map("audit_id")
  title              String?
  metaDescription    String?  @map("meta_description")
  canonicalUrl       String?  @map("canonical_url")
  language           String?
  charset            String?
  h1Count            Int      @map("h1_count")
  internalLinkCount  Int      @map("internal_link_count")
  externalLinkCount  Int      @map("external_link_count")
  createdAt          DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("inventory_results")
}

model Finding {
  id           String   @id
  auditId      String   @map("audit_id")
  ruleId       String   @map("rule_id")
  category     String
  sourceEngine String   @map("source_engine")
  outcome      String
  severity     String
  evidence     Json
  createdAt    DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("findings")
}

model Entity {
  id             String   @id
  auditId        String   @map("audit_id")
  name           String
  type           String
  sourceLocation String   @map("source_location")
  confidence     Float
  createdAt      DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("entities")
}

model GraphNode {
  id        String   @id
  auditId   String   @map("audit_id")
  entityId  String   @map("entity_id")
  name      String
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  audit                 AuditRequest        @relation(fields: [auditId], references: [id])
  outgoingRelationships GraphRelationship[] @relation("SourceNode")
  incomingRelationships GraphRelationship[] @relation("TargetNode")

  @@map("graph_nodes")
}

model GraphRelationship {
  id           String   @id
  auditId      String   @map("audit_id")
  type         String
  sourceNodeId String   @map("source_node_id")
  targetNodeId String   @map("target_node_id")
  createdAt    DateTime @default(now()) @map("created_at")

  audit      AuditRequest @relation(fields: [auditId], references: [id])
  sourceNode GraphNode    @relation("SourceNode", fields: [sourceNodeId], references: [id])
  targetNode GraphNode    @relation("TargetNode", fields: [targetNodeId], references: [id])

  @@map("graph_relationships")
}
