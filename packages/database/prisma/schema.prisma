generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model PlatformMeta {
  id             Int      @id @default(autoincrement())
  bootstrappedAt DateTime @default(now()) @map("bootstrapped_at")

  @@map("platform_meta")
}

// Identity is a deliberately separate bounded context from Client (the agency's own customer,
// CTO-059) — a User is the agency staff member signing in to use the platform. No foreign key
// from any business model (Client/Project/Audit/...) points at User, and vice versa: this sprint
// keeps authentication isolated behind its own module, per F9-S02's "Do not couple business
// modules to authentication."
model User {
  id           String    @id @default(uuid())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  status       String    @default("pending-verification")
  createdAt    DateTime  @default(now()) @map("created_at")
  verifiedAt   DateTime? @map("verified_at")

  otpCodes OtpCode[]

  @@map("users")
}

// OTP codes are never stored in plain text (`codeHash`, not `code`) and are purpose-scoped
// (email-verification vs password-reset) so a code issued for one purpose can never be replayed
// for the other. `consumedAt` enforces single-use; expiration is checked against `expiresAt` at
// verification time rather than a background sweep, matching this codebase's "compute on demand,
// no scheduled jobs" convention (`CTO-082`).
model OtpCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  purpose    String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Client {
  id            String   @id @default(uuid())
  name          String
  industry      String
  primaryDomain String   @unique @map("primary_domain")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  projects Project[]

  @@map("clients")
}

model Project {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  name             String
  canonicalWebsite String    @unique @map("canonical_website")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastAuditId      String?   @map("last_audit_id")
  baselineAuditId  String?   @map("baseline_audit_id")
  baselineSetAt    DateTime? @map("baseline_set_at")

  client Client @relation(fields: [clientId], references: [id])

  audits          AuditRequest[]
  baselineHistory ProjectBaselineHistory[]
  campaigns       OptimizationCampaign[]
  cycles          OptimizationCycle[]

  @@map("projects")
}

// Deliberately has NO foreign key to Project/Client/Audit anywhere on this model — a Pattern is
// cross-tenant aggregate intelligence (keyed only by the static, code-defined `optimizationRuleId`
// from the Optimization Knowledge Base), and the schema itself makes it structurally impossible to
// join a Pattern row back to any specific Client/Project, not just a convention enforced in code.
model OptimizationPattern {
  id                   String    @id @default(uuid())
  optimizationRuleId   String    @unique @map("optimization_rule_id")
  category             String
  occurrenceCount      Int       @map("occurrence_count")
  distinctProjectCount Int       @map("distinct_project_count")
  confidence           String
  status               String
  discoveredAt         DateTime  @map("discovered_at")
  lastRecomputedAt     DateTime  @map("last_recomputed_at")
  invalidatedAt        DateTime? @map("invalidated_at")

  @@map("optimization_patterns")
}

model OptimizationCycle {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  goal      String
  status    String    @default("planned")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  audits    AuditRequest[]
  campaigns OptimizationCampaign[]

  @@map("optimization_cycles")
}

model OptimizationCampaign {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  cycleId       String    @map("cycle_id")
  sourceAuditId String    @map("source_audit_id")
  status        String    @default("draft")
  createdAt     DateTime  @default(now()) @map("created_at")
  activatedAt   DateTime? @map("activated_at")
  completedAt   DateTime? @map("completed_at")
  archivedAt    DateTime? @map("archived_at")

  project Project           @relation(fields: [projectId], references: [id])
  cycle   OptimizationCycle @relation(fields: [cycleId], references: [id])
  actions OptimizationAction[]

  @@map("optimization_campaigns")
}

model OptimizationAction {
  id                   String    @id @default(uuid())
  campaignId           String    @map("campaign_id")
  projectId            String    @map("project_id")
  auditId              String    @map("audit_id")
  title                String
  supportingFindingIds Json      @map("supporting_finding_ids")
  status               String    @default("pending")
  createdAt            DateTime  @default(now()) @map("created_at")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  verifiedAt           DateTime? @map("verified_at")

  campaign OptimizationCampaign @relation(fields: [campaignId], references: [id])

  @@map("optimization_actions")
}

model ProjectBaselineHistory {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  auditId   String   @map("audit_id")
  setAt     DateTime @default(now()) @map("set_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_baseline_history")
}

model AuditRequest {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  cycleId     String    @map("cycle_id")
  url         String
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  cancelledAt DateTime? @map("cancelled_at")

  project Project           @relation(fields: [projectId], references: [id])
  cycle   OptimizationCycle @relation(fields: [cycleId], references: [id])

  discoveryResult         DiscoveryResult?
  crawlResult             CrawlResult?
  inventoryResult         InventoryResult?
  findings                Finding[]
  entities                Entity[]
  graphNodes              GraphNode[]
  graphRelationships      GraphRelationship[]
  aiVisibilityAssessment  AiVisibilityAssessment?
  workflowExecutionRecords WorkflowExecutionRecord[]

  @@map("audit_requests")
}

model DiscoveryResult {
  id                String   @id @default(uuid())
  auditId           String   @unique @map("audit_id")
  normalizedUrl     String   @map("normalized_url")
  robotsTxtUrl      String   @map("robots_txt_url")
  robotsTxtDetected Boolean  @map("robots_txt_detected")
  sitemapUrl        String   @map("sitemap_url")
  sitemapDetected   Boolean  @map("sitemap_detected")
  createdAt         DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("discovery_results")
}

model CrawlResult {
  id         String   @id @default(uuid())
  auditId    String   @unique @map("audit_id")
  finalUrl   String   @map("final_url")
  httpStatus Int      @map("http_status")
  headers    Json
  html       String
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("crawl_results")
}

model InventoryResult {
  id                 String   @id @default(uuid())
  auditId            String   @unique @map("audit_id")
  title              String?
  metaDescription    String?  @map("meta_description")
  canonicalUrl       String?  @map("canonical_url")
  language           String?
  charset            String?
  h1Count            Int      @map("h1_count")
  internalLinkCount  Int      @map("internal_link_count")
  externalLinkCount  Int      @map("external_link_count")
  createdAt          DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("inventory_results")
}

model Finding {
  id           String   @id
  auditId      String   @map("audit_id")
  ruleId       String   @map("rule_id")
  ruleVersion  String   @map("rule_version")
  category     String
  sourceEngine String   @map("source_engine")
  outcome      String
  severity     String
  evidence     Json
  createdAt    DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("findings")
}

model Entity {
  id             String   @id
  auditId        String   @map("audit_id")
  name           String
  type           String
  sourceLocation String   @map("source_location")
  confidence     Float
  createdAt      DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("entities")
}

model GraphNode {
  id        String   @id
  auditId   String   @map("audit_id")
  entityId  String   @map("entity_id")
  name      String
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  audit                 AuditRequest        @relation(fields: [auditId], references: [id])
  outgoingRelationships GraphRelationship[] @relation("SourceNode")
  incomingRelationships GraphRelationship[] @relation("TargetNode")

  @@map("graph_nodes")
}

model GraphRelationship {
  id           String   @id
  auditId      String   @map("audit_id")
  type         String
  sourceNodeId String   @map("source_node_id")
  targetNodeId String   @map("target_node_id")
  createdAt    DateTime @default(now()) @map("created_at")

  audit      AuditRequest @relation(fields: [auditId], references: [id])
  sourceNode GraphNode    @relation("SourceNode", fields: [sourceNodeId], references: [id])
  targetNode GraphNode    @relation("TargetNode", fields: [targetNodeId], references: [id])

  @@map("graph_relationships")
}

model AiVisibilityAssessment {
  id                   String   @id @default(uuid())
  auditId              String   @unique @map("audit_id")
  status               String
  graphCompleteness    String   @map("graph_completeness")
  entityCoverage       String   @map("entity_coverage")
  relationshipCoverage String   @map("relationship_coverage")
  missingSignals       Json     @map("missing_signals")
  assessedAt           DateTime @map("assessed_at")
  createdAt            DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("ai_visibility_assessments")
}

model WorkflowExecutionRecord {
  id           String   @id @default(uuid())
  auditId      String   @map("audit_id")
  stepId       String   @map("step_id")
  status       String
  startedAt    DateTime @map("started_at")
  completedAt  DateTime @map("completed_at")
  durationMs   Int      @map("duration_ms")
  errorCode    String?  @map("error_code")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  audit AuditRequest @relation(fields: [auditId], references: [id])

  @@map("workflow_execution_records")
}
